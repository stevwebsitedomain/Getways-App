# Paste this into Ultramsg → Instance settings → Webhook URL
ULTAMSG_WEBHOOK_PUBLIC_URL=https://YOUR-DOMAIN.com/whatsapp-webhook.php
# Optional explicit cron key for whatsapp-cron.php (defaults to hash of ULTAMSG_TOKEN)
WA_CRON_SECRET=

# --- Google Sign-In (login.php / register.php) ---
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application
# Authorized JavaScript origins (no path):
#   http://localhost
#   http://127.0.0.1
#   https://getway.legitconsult.co.tz
#   https://getways-app.onrender.com
# Authorized redirect URIs:
#   http://localhost/Getways-App/frontend/web/google-callback.php
#   https://getway.legitconsult.co.tz/google-callback.php
#   https://getways-app.onrender.com/google-callback.php
# OAuth consent screen: External + Publishing status In production
# (Testing mode only allows listed test emails.)
GOOGLE_CLIENT_ID=

# --- Apify (CRM Facebook search) ---
# Actor: apify/facebook-search-scraper
# Create token at https://console.apify.com/account/integrations
