# =============================================================================
# Getways-App environment (example — copy to .env and fill real values)
# NEVER commit .env with real secrets to Git.
# =============================================================================

# --- Database (Node + optional) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=getways_app
DB_USER=root
DB_PASSWORD=

# --- Node TIS backend (tis-clickpesa/) ---
PORT=5000
BASE_URL=https://YOUR-DOMAIN.com
BASE_API_URL=https://YOUR-DOMAIN.com
TIS_API_UPSTREAM=https://YOUR-DOMAIN.com
CORS_ORIGINS=http://localhost,https://YOUR-DOMAIN.com

# Node ClickPesa checkout (collections) — same dashboard credentials often work
CLIENT_ID=ID40PGDVH58YxcPHSxFvZbg6QaT2LK4O
API_KEY=SKlGyQ8oJVhMRD7MjRS2cjFxNjNICAQqfjIXE1YeoV
CHECKSUM_KEY=CHK6uSqz8r8rWAs1TKEZQK18WoWwsaaVBMp

# --- Yii PHP ClickPesa BillPay + Automatic Payout (primary integration) ---
# Obtain from ClickPesa Dashboard → Settings → Developers (Payout API enabled)
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties
CLICKPESA_CLIENT_ID=ID40PGDVH58YxcPHSxFvZbg6QaT2LK4O
CLICKPESA_API_KEY=SKlGyQ8oJVhMRD7MjRS2cjFxNjNICAQqfjIXE1YeoV
CLICKPESA_CHECKSUM_ENABLED=false
CLICKPESA_CHECKSUM_SECRET=CHK6uSqz8r8rWAs1TKEZQK18WoWwsaaVBMp
CLICKPESA_WEBHOOK_URL=https://YOUR-DOMAIN.com/api/clickpesa/webhook
CLICKPESA_WEBHOOK_TOKEN=
CLICKPESA_ENCRYPTION_KEY=
CLICKPESA_INTERNAL_API_TOKEN=

# Payout safety — keep disabled until ClickPesa confirms Payout API access
CLICKPESA_PAYOUT_ENABLED=false
CLICKPESA_PAYOUT_TEST_MODE=true
CLICKPESA_DEFAULT_PAYOUT_PHONE=255715296092
CLICKPESA_HTTP_TIMEOUT_SECONDS=30
CLICKPESA_TOKEN_REFRESH_BEFORE_EXPIRY_SECONDS=300

# Same Autopay app as USSD (generate-token → Mobile Money payout endpoints)
AUTOPAY_CLIENT_ID=
AUTOPAY_API_KEY=
AUTOPAY_CHECKSUM_KEY=
CHECKSUM_KEY=

# Admin proxy (optional)
