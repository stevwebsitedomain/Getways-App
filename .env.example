# --- Ultramsg WhatsApp (manual send) ---
# Copy from Ultramsg dashboard → Authorization box
ULTAMSG_INSTANCE_ID=instanceXXXXXX
ULTAMSG_TOKEN=
ULTAMSG_API_URL=https://api.ultramsg.com/instanceXXXXXX
